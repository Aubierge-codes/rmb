# --- Secrets and local configuration (NEVER commit) ---
!.env.example

# --- Private or large source documents (keep local, share through a private channel) ---
downloads/*
!downloads/README.md
*.pdf
*.part
*.zip

# --- Local data generated by the apps ---
ai-service/data/kb.json
case-service/data/*.sqlite
case-service/data/*.sqlite-journal
!case-service/data/.gitkeep

# --- Build, test and editor noise ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.log
.DS_Store
Thumbs.db
.idea/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
config.bat
node_modules
