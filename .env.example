# Copy to .env and change every value marked CHANGE. Never commit .env.
DB_PASSWORD=CHANGE-me-db-password
SERVICE_KEY=CHANGE-me-long-random-string          # shared secret between the chat API and the case service
DEMO_ADMIN_PASSWORD=CHANGE-me-admin
DEMO_OFFICER_PASSWORD=CHANGE-me-officer
HTTP_PORT=8088

# LLM adapter: "extractive" needs no key (quotes the documents). "gemini" or "anthropic" write grounded answers.
# Gemini: free key from https://aistudio.google.com/apikey . Check the current model name there if this one is retired.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional, only if LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Origins allowed to call the chat API (the site embedding the widget). Use * only for local demos.
ALLOWED_ORIGINS=*
